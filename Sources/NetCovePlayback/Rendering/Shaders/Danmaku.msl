//
//  Danmaku.msl
//  弹幕批量渲染：每条一个实例四边形，纹理来自 CPU 侧的 CoreText 图集。
//  一次 draw call 画完同屏全部弹幕 → 200+ 条也不掉帧（SwiftUI 版会）。
//

#include <metal_stdlib>
using namespace metal;

struct DanmakuInstance {
    float2 center;      // 归一化设备坐标
    float2 size;        // 归一化尺寸
    float2 uvOrigin;    // 图集左上角 uv
    float2 uvSize;      // 图集内尺寸
    float4 color;
};

struct VSOut {
    float4 position [[position]];
    float2 uv;
    float4 color;
};

vertex VSOut danmakuVertex(uint vid [[vertex_id]],
                           uint iid [[instance_id]],
                           constant DanmakuInstance *instances [[buffer(0)]]) {
    float2 corners[6] = {
        float2(-1.0, -1.0), float2(1.0, -1.0), float2(-1.0, 1.0),
        float2(-1.0, 1.0), float2(1.0, -1.0), float2(1.0, 1.0)
    };
    DanmakuInstance inst = instances[iid];
    float2 corner = corners[vid];

    VSOut out;
    out.position = float4(inst.center + corner * inst.size * 0.5, 0.0, 1.0);
    float2 local = (corner + 1.0) * 0.5;
    out.uv = inst.uvOrigin + float2(local.x, 1.0 - local.y) * inst.uvSize;
    out.color = inst.color;
    return out;
}

fragment float4 danmakuFragment(VSOut in [[stage_in]],
                                texture2d<float> atlas [[texture(0)]]) {
    constexpr sampler s(filter::linear, address::clamp_to_edge);
    float coverage = atlas.sample(s, in.uv).a;
    if (coverage < 0.01) discard_fragment();
    return float4(in.color.rgb, in.color.a * coverage);
}
